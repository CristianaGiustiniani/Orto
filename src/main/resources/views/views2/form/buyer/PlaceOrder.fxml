<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="1280.0" stylesheets="@../../css/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER_LEFT" maxWidth="-Infinity" prefHeight="68.0" prefWidth="1240.0">
         <children>
            <Text fx:id="textSellerName" fill="#005000" strokeType="OUTSIDE" strokeWidth="0.0" text="SELLER_NAME">
               <font>
                  <Font name="Calibri Bold" size="36.0" />
               </font>
            </Text>
            <Text fx:id="textOrderStep" fill="GREEN" strokeType="OUTSIDE" strokeWidth="0.0" text="STEP">
               <font>
                  <Font name="Calibri Bold" size="32.0" />
               </font>
            </Text>
         </children>
      </VBox>
      <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="39.0" prefWidth="1280.0">
         <left>
            <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#onClickButtonBack" styleClass="bt-back" text="BACK" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets left="20.0" right="20.0" />
               </BorderPane.margin>
            </Button>
         </left>
         <right>
            <Button fx:id="buttonNext" mnemonicParsing="false" onAction="#onClickButtonNext" styleClass="bt-back" text="NEXT" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets left="20.0" right="20.0" />
               </BorderPane.margin>
            </Button>
         </right>
      </BorderPane>
      <Pane fx:id="paneContent" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="333.0" prefWidth="1280.0" />
   </children>
</VBox>
