<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>


<HBox alignment="CENTER" prefHeight="333.0" prefWidth="1280.0" stylesheets="@../../../css/main.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Button fx:id="buttonPayOnline" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#clickButtonPayOnline" prefHeight="250.0" prefWidth="250.0" styleClass="bt-uc" text="PAYONLINE">
         <HBox.margin>
            <Insets left="30.0" right="30.0" />
         </HBox.margin>
      </Button>
      <Button fx:id="buttonPayViaCash" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#clickButtonPayViaCash" prefHeight="250.0" prefWidth="250.0" styleClass="bt-uc" text="PAYVIACASH">
         <HBox.margin>
            <Insets left="30.0" right="30.0" />
         </HBox.margin>
      </Button>
   </children>
</HBox>
