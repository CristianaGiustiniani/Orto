<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="1240.0">
         <children>
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <SVGPath content="M0,0 L293,0 L308,15 L293,30 L0,30 L15,15 Z" fill="#92d050" />
                  <Label fx:id="labelProductSelection" text="PRODUCTSELECTION" textFill="WHITE">
                     <font>
                        <Font name="Calibri Bold" size="16.0" />
                     </font>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </Label>
               </children>
            </StackPane>
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <SVGPath content="M0,0 L293,0 L308,15 L293,30 L0,30 L15,15 Z" fill="#92d050" />
                  <Label fx:id="labelDelivery" text="DELIVERY" textFill="WHITE">
                     <font>
                        <Font name="Calibri Bold" size="16.0" />
                     </font>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </Label>
               </children>
            </StackPane>
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <SVGPath content="M0,0 L293,0 L308,15 L293,30 L0,30 L15,15 Z" fill="GREEN" />
                  <Label fx:id="labelPayment" text="PAYMENT" textFill="WHITE">
                     <font>
                        <Font name="Calibri Bold" size="16.0" />
                     </font>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </Label>
               </children>
            </StackPane>
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <SVGPath content="M0,0 L293,0 L308,15 L293,30 L0,30 L15,15 Z" fill="#92d050" />
                  <Label fx:id="labelSummary" text="SUMMARY" textFill="WHITE">
                     <font>
                        <Font name="Calibri Bold" size="16.0" />
                     </font>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </Label>
               </children>
            </StackPane>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="333.0" prefWidth="1280.0" stylesheets="@../../../css/main.css">
         <children>
            <Button fx:id="buttonPayOnline" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#clickButtonPayOnline" prefHeight="250.0" prefWidth="250.0" styleClass="bt-uc" text="PAYONLINE" visible="false">
               <HBox.margin>
                  <Insets left="30.0" right="30.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="buttonPayViaCash" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#clickButtonPayViaCash" prefHeight="250.0" prefWidth="250.0" styleClass="bt-uc" text="PAYVIACASH" visible="false">
               <HBox.margin>
                  <Insets left="30.0" right="30.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
