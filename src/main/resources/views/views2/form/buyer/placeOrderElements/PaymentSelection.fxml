<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" styleClass="background" stylesheets="@../../../css/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER" prefWidth="1280.0" styleClass="background" stylesheets="@../../../css/main.css">
         <children>
            <Text fx:id="textTotal" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="r-text" text="Text">
               <HBox.margin>
                  <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
               </HBox.margin>
            </Text>
            <Text fx:id="textTotalPrice" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="r-text" text="Text">
               <HBox.margin>
                  <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
               </HBox.margin>
            </Text>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="333.0" prefWidth="1280.0" styleClass="background" stylesheets="@../../../css/main.css">
         <children>
            <Button fx:id="buttonPayOnline" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#clickButtonPayOnline" prefHeight="250.0" prefWidth="250.0" styleClass="bt-uc" text="PAYONLINE" visible="false">
               <HBox.margin>
                  <Insets left="30.0" right="30.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="buttonPayViaCash" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#clickButtonPayViaCash" prefHeight="250.0" prefWidth="250.0" styleClass="bt-uc" text="PAYVIACASH" visible="false">
               <HBox.margin>
                  <Insets left="30.0" right="30.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
