<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<HBox alignment="CENTER" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="70.0" prefWidth="1040.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="260.0">
         <children>
            <Text fx:id="textFarmerName" strokeType="OUTSIDE" strokeWidth="0.0" text="FarmerName">
               <font>
                  <Font name="Calibri" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </Text>
         </children>
      </VBox>
      <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="260.0">
         <children>
            <Text fx:id="textFarmerLocation" strokeType="OUTSIDE" strokeWidth="0.0" text="FamerLocation">
               <font>
                  <Font name="Calibri" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </Text>
         </children>
      </VBox>
      <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="260.0">
         <children>
            <Text fx:id="textProductTypes" strokeType="OUTSIDE" strokeWidth="0.0" text="ProductTypes">
               <font>
                  <Font name="Calibri" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </Text>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="260.0">
         <children>
            <Button fx:id="buttonPlaceOrder" alignment="CENTER" mnemonicParsing="false" styleClass="bt-stepAction1" text="PlaceOrder" />
         </children>
      </VBox>
   </children>
</HBox>
